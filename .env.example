NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3000
# Optional for worker-only deployments.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evm_copy_mint
REDIS_URL=redis://localhost:6379
CHAINS_CONFIG_PATH=./config/chains.json
ETHEREUM_RPC_URL=https://replace-with-ethereum-http-rpc
ETHEREUM_WS_RPC_URL=wss://replace-with-ethereum-websocket-rpc
BASE_RPC_URL=https://replace-with-base-http-rpc
BASE_WS_RPC_URL=wss://replace-with-base-websocket-rpc
ROBINHOOD_RPC_URL=https://replace-with-robinhood-http-rpc
ROBINHOOD_WS_RPC_URL=wss://replace-with-robinhood-websocket-rpc
# Development/test only. Never configure this in production.
# DEVELOPMENT_PRIVATE_KEY=0x...
# Production signer configuration. The endpoint must implement GET /address and POST /sign.
SIGNER_PROVIDER=none
# SIGNER_ADDRESS=0x...
# SIGNER_ENDPOINT=https://signer.internal.example
# SIGNER_AUTH_TOKEN=replace-with-external-signer-token
