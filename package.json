{
  "name": "evm-copy-mint-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Production foundation for a generic EVM copy mint Telegram bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:rollback": "tsx src/database/migrate.ts down",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "test:db": "vitest run tests/database --pool=threads --poolOptions.threads.singleThread",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "bullmq": "^5.58.5",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "telegraf": "^4.16.3",
    "viem": "^2.31.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.2",
    "eslint": "^9.27.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.4"
  }
}
